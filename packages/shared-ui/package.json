{
  "name": "@one-love-wealth/shared-ui",
  "version": "0.1.0",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./stores": {
      "types": "./src/stores/index.ts",
      "default": "./src/stores/index.ts"
    },
    "./styles": "./src/styles/base.css",
    "./styles/base": "./src/styles/base.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/theme": "./src/styles/theme.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/animations": "./src/styles/animations.css",
    "./styles/animations.css": "./src/styles/animations.css",
    "./styles/utilities": "./src/styles/utilities.css",
    "./styles/utilities.css": "./src/styles/utilities.css",
    "./styles/index": "./src/styles/index.css",
    "./styles/index.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "dependencies": {
